# ==============================================================================
# ReviewFlow - Environment Configuration Template
# Milestone 2: Google OAuth 2.0 & Token Vault Foundation
# ==============================================================================

# Database Configuration (PostgreSQL)
# Note: Local development database port is configured here (e.g. 5432 or 9999).
# DO NOT confuse database port with Next.js web application port (3000).
DATABASE_URL="postgresql://postgres:postgres@localhost:9999/reviewflow?schema=public"

# Application Environment & Base URL
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="ReviewFlow"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication (Milestone 1/2)
NEXTAUTH_SECRET="your-32-byte-hex-or-base64-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Operator Multi-Account Authorization)
# Obtain from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Application Type: Web application
# Authorized Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# OAuth 2.0 Least-Privilege Scopes (space-separated)
# Default: openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile
GOOGLE_OAUTH_SCOPES="openid https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile"

# Token Vault Encryption Key (AES-256-GCM)
# MUST be a cryptographically secure 256-bit key (32 bytes).
# Generate using: openssl rand -hex 32  (or: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
# Used to encrypt Google OAuth access/refresh tokens before storing in PostgreSQL.
TOKEN_ENCRYPTION_KEY="your-64-character-hex-or-32-byte-secret-key"
# ENCRYPTION_KEY is supported as an alias for backwards compatibility:
# ENCRYPTION_KEY="your-64-character-hex-or-32-byte-secret-key"

# Future Milestone 3: AI Provider Integration (Gemini / Anthropic / OpenAI)
# Used exclusively server-side for draft generation based on operator-entered genuine experiences.
AI_API_KEY=""
